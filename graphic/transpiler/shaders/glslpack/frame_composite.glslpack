AIMER-OPENGL-SHADER-PACK-1
[VERTEX]
#version 330 core
struct VertexOutput {
    vec4 position;
};

void main() {
    uint vertex_index = uint(gl_VertexID);
    vec2 corners[6] = vec2[6](vec2(-1.0, 1.0), vec2(1.0, 1.0), vec2(-1.0, -1.0), vec2(1.0, 1.0), vec2(1.0, -1.0), vec2(-1.0, -1.0));
    VertexOutput output_ = VertexOutput(vec4(0.0));
    vec2 _e24 = corners[vertex_index];
    output_.position = vec4(_e24, 0.0, 1.0);
    VertexOutput _e28 = output_;
    gl_Position = _e28.position;
    return;
}


[FRAGMENT]
#version 330 core
struct VertexOutput {
    vec4 position;
};
uniform sampler2D _group_0_binding_0_fs;

layout(location = 0) out vec4 _fs2p_location0;

void main() {
    vec4 position = gl_FragCoord;
    vec4 _e5 = texelFetch(_group_0_binding_0_fs, ivec2(position.xy), 0);
    _fs2p_location0 = _e5;
    return;
}


[RESOURCES]
TEXTURE 0 0 _group_0_binding_0_fs
