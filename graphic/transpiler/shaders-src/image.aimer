shader image;

import aimer::color::*;
import aimer::clip::clip_alpha;

uniform struct Viewport {
    size: vec2,
    surface_is_srgb: f32,
    _pad: f32,
}

#[bind(0, 0)]
uniform viewport: Viewport;
#[bind(1, 0)]
texture t_diffuse: texture2d;
#[bind(1, 1)]
sampler s_diffuse;

#[varying]
struct VertexOutput {
    @position position: vec4,
    uv: vec2,
    pixel_pos: vec2,
    clip_rect: vec4,
    clip_border_radius: vec4,
    alpha: f32,
    source_premultiplied: f32,
}

#[input(step = instance)]
struct ImageInstance {
    pos: vec2,
    size: vec2,
    uv_offset: vec2,
    uv_scale: vec2,
    clip_rect: vec4,
    clip_border_radius: vec4,
    alpha: f32,
    source_premultiplied: f32,
}

const CORNERS: [vec2; 6] = [
    vec2(0.0, 0.0),
    vec2(1.0, 0.0),
    vec2(0.0, 1.0),
    vec2(1.0, 0.0),
    vec2(1.0, 1.0),
    vec2(0.0, 1.0),
];

#[vertex]
fn vs_main(vi: @vertex_index, inst: ImageInstance) -> VertexOutput {
    let corner = CORNERS[vi];
    let pixel_pos = inst.pos + corner * inst.size;

    let ndc = vec2(
        (pixel_pos.x / viewport.size.x) * 2.0 - 1.0,
        1.0 - (pixel_pos.y / viewport.size.y) * 2.0,
    );

    let mut out: VertexOutput;
    out.position = vec4(ndc, 0.0, 1.0);
    out.uv = inst.uv_offset + corner * inst.uv_scale;
    out.pixel_pos = pixel_pos;
    out.clip_rect = inst.clip_rect;
    out.clip_border_radius = inst.clip_border_radius;
    out.alpha = inst.alpha;
    out.source_premultiplied = inst.source_premultiplied;
    out
}

#[fragment]
fn fs_main(input: VertexOutput) -> @frag_color {
    let mut color = t_diffuse.sample(s_diffuse, input.uv);

    let mut result: vec4;
    if input.source_premultiplied > 0.5 {
        // Retained layers are render targets. Their RGB channels already
        // carry alpha, unlike decoded image uploads. On an unorm target the
        // stored channels are sRGB-encoded premultiplied values, so recover
        // straight sRGB before applying the ordinary image conversion. An
        // sRGB view decodes the layer to linear premultiplied values while it
        // is sampled; those values are already in the target blend space.
        let a = color_offset(color.a);
        if viewport.surface_is_srgb >= 1.5 {
            result = vec4(color.rgb, a);
        } else if viewport.surface_is_srgb < 0.5 {
            if a > 0.00001 {
                let straight = color.rgb / a;
                result = vec4(
                    linear_to_srgb(srgb_to_linear(straight.r)) * a,
                    linear_to_srgb(srgb_to_linear(straight.g)) * a,
                    linear_to_srgb(srgb_to_linear(straight.b)) * a,
                    a,
                );
            } else {
                result = vec4(0.0);
            }
        } else {
            result = vec4(color.rgb, a);
        }
    } else if viewport.surface_is_srgb >= 1.5 {
        // Ordinary decoded images are straight-alpha and already use the
        // platform's target encoding on Android.
        let a = color_offset(color.a);
        result = vec4(color.rgb * a, a);
    } else {
        color = vec4(
            srgb_to_linear(color.r),
            srgb_to_linear(color.g),
            srgb_to_linear(color.b),
            color_offset(color.a),
        );

        result = vec4(color.rgb * color.a, color.a);

        if viewport.surface_is_srgb < 0.5 {
            let a = color.a;
            if a > 0.00001 {
                let unpremul = result.rgb / a;
                let srgb_rgb = vec3(linear_to_srgb(unpremul.r), linear_to_srgb(unpremul.g), linear_to_srgb(unpremul.b));
                result = vec4(srgb_rgb * a, a);
            }
        }
    }

    let ca = clip_alpha(input.pixel_pos, input.clip_rect, input.clip_border_radius);
    result * (ca * input.alpha)
}
