shader frame_composite;

#[bind(0, 0)]
texture source_frame: texture2d;

#[varying]
struct VertexOutput {
    @position position: vec4,
}

const CORNERS: [vec2; 6] = [
    vec2(-1.0, 1.0),
    vec2(1.0, 1.0),
    vec2(-1.0, -1.0),
    vec2(1.0, 1.0),
    vec2(1.0, -1.0),
    vec2(-1.0, -1.0),
];

#[vertex]
fn vs_main(vertex_index: @vertex_index) -> VertexOutput {
    VertexOutput { position: vec4(CORNERS[vertex_index], 0.0, 1.0) }
}

#[fragment]
fn fs_main(position: @frag_coord) -> @frag_color {
    source_frame.load(vec2<i32>(position.xy), 0)
}
