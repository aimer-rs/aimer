module aimer::color;

pub fn correct_alpha(input: f32) -> f32 {
    input
}

pub fn color_offset(input: f32) -> f32 {
    input
}

pub fn srgb_to_linear(c: f32) -> f32 {
    if c <= 0.04045 {
        return c / 12.92;
    }
    pow((c + 0.055) / 1.055, 2.4)
}

// Convert a single linear channel back to sRGB.
pub fn linear_to_srgb(c: f32) -> f32 {
    if c <= 0.0031308 {
        return c * 12.92;
    }
    1.055 * pow(c, 1.0 / 2.4) - 0.055
}

// Convert an sRGB colour (with alpha) to linear space. Alpha is kept as-is.
pub fn srgb_color_to_linear(c: vec4) -> vec4 {
    vec4(srgb_to_linear(c.r), srgb_to_linear(c.g), srgb_to_linear(c.b), c.a)
}

// Convert a linear colour (with alpha) back to sRGB space.
pub fn linear_color_to_srgb(c: vec4) -> vec4 {
    vec4(linear_to_srgb(c.r), linear_to_srgb(c.g), linear_to_srgb(c.b), c.a)
}
