shader color_melt;

import aimer::clip::clip_alpha;
import aimer::color::srgb_color_to_linear;
import aimer::sdf::sdf_rounded_rect;

// Colors that flow into one another like wax or paint on a warm surface.
//
// The pattern is a stack of sine bands whose coordinates are bent four times by
// the bands before them (domain warping), then dragged slowly downward. Four
// palette colors are blended by three of those bands; `contrast` narrows the
// blend between colors from a smooth wash to hard melted edges.
//
// Everything above `time` is the frame header every effect shares; the rest are
// this effect's parameters, written in the same order by `Melt::write_params`.
uniform struct Frame {
    target_size: vec2,
    surface_is_srgb: f32,
    opacity: f32,
    rect: vec4,
    clip_rect: vec4,
    clip_radii: vec4,
    // Seconds of animation, already multiplied by the speed control.
    time: f32,
    // Pattern zoom: larger shows more, smaller blobs.
    scale: f32,
    // How far the bands bend each other: 0 is a calm wash, 2 is turbulent.
    melt: f32,
    // 1 blends smoothly; higher values make the color edges sharper.
    contrast: f32,
    // Corner radius as a fraction of the shorter side (0 to 0.5).
    radius: f32,
    // Film-grain strength (0 to 1).
    grain: f32,
    _pad0: f32,
    _pad1: f32,
    color_a: vec4,
    color_b: vec4,
    color_c: vec4,
    color_d: vec4,
}

#[bind(0, 0)]
uniform frame: Frame;

#[varying]
struct VertexOutput {
    @position position: vec4,
    pixel_pos: vec2,
}

const CORNERS: [vec2; 6] = [
    vec2(0.0, 0.0),
    vec2(1.0, 0.0),
    vec2(0.0, 1.0),
    vec2(1.0, 0.0),
    vec2(1.0, 1.0),
    vec2(0.0, 1.0),
];

#[vertex]
fn vs_main(vi: @vertex_index) -> VertexOutput {
    let pixel = frame.rect.xy + CORNERS[vi] * frame.rect.zw;
    let ndc = vec2(
        pixel.x / frame.target_size.x * 2.0 - 1.0,
        1.0 - pixel.y / frame.target_size.y * 2.0,
    );
    VertexOutput { position: vec4(ndc, 0.0, 1.0), pixel_pos: pixel }
}

// One bend of the coordinates by the bands before it. `k` varies the speed,
// direction and weight of each pass so the four passes do not repeat.
fn bend(p: vec2, k: f32) -> vec2 {
    let weight = frame.melt / (1.0 + k * 0.55);
    vec2(
        p.x + weight * sin(p.y * 1.7 + frame.time * (0.55 + k * 0.17) + k * 1.3),
        p.y + weight * cos(p.x * 1.4 - frame.time * (0.45 + k * 0.11) + k * 2.1),
    )
}

// A band in 0..1, sharpened around its midpoint by `contrast`.
fn band(x: f32) -> f32 {
    let half_width = 0.5 / max(frame.contrast, 1.0);
    smoothstep(0.5 - half_width, 0.5 + half_width, 0.5 + 0.5 * sin(x))
}

// Cheap per-pixel noise in 0..1.
fn noise(p: vec2) -> f32 {
    fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453)
}

#[fragment]
fn fs_main(input: VertexOutput) -> @frag_color {
    let size = frame.rect.zw;
    let local = input.pixel_pos - frame.rect.xy;
    let uv = local / size;

    // Square cells, centered on the rectangle, the whole pattern sliding down
    // over time so the colors seem to run.
    let aspect = size.x / size.y;
    let mut p = vec2((uv.x - 0.5) * aspect, uv.y - 0.5) * frame.scale * 3.0;
    p.y = p.y - frame.time * 0.15;
    p = bend(p, 0.0);
    p = bend(p, 1.0);
    p = bend(p, 2.0);
    p = bend(p, 3.0);

    let first = band(p.x * 1.1 + p.y * 0.7 + frame.time * 0.30);
    let second = band(p.y * 1.3 - p.x * 0.9 - frame.time * 0.20 + 2.0);
    let blend = band(p.x * 0.6 + p.y * 0.8 + frame.time * 0.10 + 4.0);
    let upper = mix(frame.color_a, frame.color_b, first);
    let lower = mix(frame.color_c, frame.color_d, second);
    let mut color = mix(upper, lower, blend);
    color = vec4(color.rgb + (noise(input.pixel_pos) - 0.5) * frame.grain * 0.1, color.a);

    // Palettes are authored in sRGB. A view that encodes for us (1) wants linear
    // values; the other surfaces take them as they are.
    if frame.surface_is_srgb >= 0.5 && frame.surface_is_srgb < 1.5 {
        color = srgb_color_to_linear(color);
    }

    let half = size * 0.5;
    let r = frame.radius * min(size.x, size.y);
    let edge = 1.0 - smoothstep(-0.5, 0.5, sdf_rounded_rect(local - half, half, vec4(r, r, r, r)));
    let coverage = color.a * edge * frame.opacity * clip_alpha(input.pixel_pos, frame.clip_rect, frame.clip_radii);
    // Premultiplied, like every other pipeline's output.
    vec4(color.rgb * coverage, coverage)
}
