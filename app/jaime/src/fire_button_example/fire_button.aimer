shader fire_button;

import aimer::clip::clip_alpha;
import aimer::color::srgb_color_to_linear;
import aimer::sdf::sdf_rounded_rect;

// Flames that rise from the outline of a button.
//
// The picture is a field of "heat" that falls off with distance from the button
// (distances above the button count less than the others, so the fire climbs
// instead of spreading evenly). Rising fractal noise eats into that field and
// leaves ragged tongues; the remaining heat is mapped onto a black-body-like
// ramp from dark red to white. `level` is the fuel: it shortens the flames,
// breaks them into separate licks, and finally leaves nothing.
//
// Everything above `time` is the frame header every effect shares; the rest are
// this effect's parameters, written in the same order by `Fire::write_params`.
uniform struct Frame {
    target_size: vec2,
    surface_is_srgb: f32,
    opacity: f32,
    rect: vec4,
    clip_rect: vec4,
    clip_radii: vec4,
    // Seconds of animation.
    time: f32,
    // Fuel, 0 (out) to 1 (full blaze).
    level: f32,
    // The button's corner radius as a fraction of its half height (1 is a pill).
    corner: f32,
    _pad0: f32,
    // The button's center (xy) and half size (zw), as fractions of the rect, so
    // the picture does not depend on the display scale.
    button: vec4,
}

#[bind(0, 0)]
uniform frame: Frame;

#[varying]
struct VertexOutput {
    @position position: vec4,
    pixel_pos: vec2,
}

const CORNERS: [vec2; 6] = [
    vec2(0.0, 0.0),
    vec2(1.0, 0.0),
    vec2(0.0, 1.0),
    vec2(1.0, 0.0),
    vec2(1.0, 1.0),
    vec2(0.0, 1.0),
];

#[vertex]
fn vs_main(vi: @vertex_index) -> VertexOutput {
    let pixel = frame.rect.xy + CORNERS[vi] * frame.rect.zw;
    let ndc = vec2(
        pixel.x / frame.target_size.x * 2.0 - 1.0,
        1.0 - pixel.y / frame.target_size.y * 2.0,
    );
    VertexOutput { position: vec4(ndc, 0.0, 1.0), pixel_pos: pixel }
}

// Cheap lattice hash in 0..1.
fn hash(p: vec2) -> f32 {
    fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453)
}

// Smoothly interpolated value noise in 0..1.
fn value_noise(p: vec2) -> f32 {
    let cell = floor(p);
    let f = fract(p);
    let u = f * f * (vec2(3.0, 3.0) - f * 2.0);
    let a = hash(cell);
    let b = hash(cell + vec2(1.0, 0.0));
    let c = hash(cell + vec2(0.0, 1.0));
    let d = hash(cell + vec2(1.0, 1.0));
    mix(mix(a, b, u.x), mix(c, d, u.x), u.y)
}

// Four octaves of value noise, normalized to 0..1.
fn fbm(p: vec2) -> f32 {
    let mut sum = value_noise(p) * 0.5;
    sum = sum + value_noise(p * 2.03 + vec2(17.0, 3.0)) * 0.25;
    sum = sum + value_noise(p * 4.01 + vec2(5.0, 29.0)) * 0.125;
    sum = sum + value_noise(p * 8.07 + vec2(41.0, 11.0)) * 0.0625;
    sum / 0.9375
}

// Dark red, orange, yellow, then almost white as the heat climbs.
fn flame_color(heat: f32) -> vec3 {
    let ember = vec3(0.55, 0.05, 0.02);
    let orange = vec3(1.0, 0.36, 0.03);
    let yellow = vec3(1.0, 0.78, 0.16);
    let white = vec3(1.0, 0.97, 0.78);
    let mut color = mix(ember, orange, smoothstep(0.08, 0.40, heat));
    color = mix(color, yellow, smoothstep(0.40, 0.72, heat));
    mix(color, white, smoothstep(0.72, 1.0, heat))
}

#[fragment]
fn fs_main(input: VertexOutput) -> @frag_color {
    let size = frame.rect.zw;
    let local = input.pixel_pos - frame.rect.xy;
    // Every length below is a fraction of the rect height, so the fire keeps its
    // proportions at any display scale.
    let unit = size.y;
    let level = clamp(frame.level, 0.0, 1.0);

    // Distance outside the button, with distance above it counting for less.
    let half = frame.button.zw * size;
    let q = local - frame.button.xy * size;
    let outside = max(sdf_rounded_rect(q, half, vec4(
        frame.corner * half.y, frame.corner * half.y, frame.corner * half.y, frame.corner * half.y
    )), 0.0);
    let above = smoothstep(-half.y * 0.5, half.y * 0.5, 0.0 - q.y);
    // Flames taper toward the button's ends, so the fire is a mound, not a box.
    let ends = clamp((abs(q.x) - half.x * 0.55) / (half.x * 0.45), 0.0, 1.0);
    let reach_dist = outside * mix(3.2, 1.0, above) * (1.0 + 1.6 * ends);

    // How far the flames reach: nothing at no fuel, 0.4 of the rect at full.
    let reach = max(unit * 0.4 * level, 1.0);
    let t = reach_dist / reach;

    // Noise that travels upward, with a sideways sway that grows with height.
    // Tall, narrow cells, so the noise pulls into upright tongues.
    let sway = sin(local.y / (0.11 * unit) - frame.time * 3.1) * 0.45 * t;
    let n = fbm(vec2(local.x / (0.085 * unit) + sway, local.y / (0.27 * unit) + frame.time * 1.5));

    // A low fire is torn into separate licks: the noise counts for more.
    let rag = (0.42 + t) * (0.9 + (1.0 - level) * 0.8);
    let heat = clamp((1.0 - t) * 1.15 + (n - 0.5) * rag * 1.3 - 0.08, 0.0, 1.0);

    // A soft halo around the button that dims with the fuel.
    let halo = exp(0.0 - outside / (0.16 * unit)) * level * level * 0.45;

    let coverage = smoothstep(0.05, 0.28, heat);
    // Only the core gets to white.
    let flame = flame_color(heat * 0.82);
    let alpha = max(coverage, halo);
    let mut rgb = (flame * coverage + vec3(1.0, 0.32, 0.04) * halo * (1.0 - coverage)) / max(alpha, 0.0001);

    // The picture dies out toward the rect's own edge instead of being cut by it.
    let fade_px = 0.09 * unit;
    let edge = clamp(local.y / fade_px, 0.0, 1.0)
        * clamp(local.x / fade_px, 0.0, 1.0)
        * clamp((size.x - local.x) / fade_px, 0.0, 1.0)
        * clamp((size.y - local.y) / fade_px, 0.0, 1.0);

    // Colors are authored in sRGB. A view that encodes for us (1) wants linear
    // values; the other surfaces take them as they are.
    if frame.surface_is_srgb >= 0.5 && frame.surface_is_srgb < 1.5 {
        rgb = srgb_color_to_linear(vec4(rgb, 1.0)).rgb;
    }

    let a = alpha * edge * frame.opacity * clip_alpha(input.pixel_pos, frame.clip_rect, frame.clip_radii);
    // Premultiplied, like every other pipeline's output.
    vec4(rgb * a, a)
}
