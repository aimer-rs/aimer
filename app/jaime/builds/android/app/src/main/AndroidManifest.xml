<?xml version="1.0" encoding="utf-8"?>
<!-- The application id comes from `namespace` / `applicationId` in
     app/build.gradle.kts; declaring `package` here is ignored since AGP 8. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AimerFullscreenTheme">
        <activity
            android:name="com.aimer.AimerActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|keyboardHidden|screenSize|uiMode"
            android:windowSoftInputMode="stateHidden|adjustResize">
            <meta-data android:name="android.app.lib_name" android:value="Jaime" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Links that open the app: `jaime://topic/42`. A web link needs
                 `https` and a host here, plus an `autoVerify` assetlinks setup. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="jaime" />
            </intent-filter>
        </activity>
    </application>

</manifest>