<?xml version="1.0" encoding="utf-8"?>
<!-- The application id comes from `namespace` / `applicationId` in
     app/build.gradle.kts; declaring `package` here is ignored since AGP 8. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
      <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
      <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS"/>
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AimerFullscreenTheme">
        <!-- `uiMode` in `configChanges` keeps the activity alive when the user
             switches the system between light and dark: without it Android
             destroys and recreates the activity, restarting the app instead of
             letting the theme animate into the new appearance. -->
        <activity
            android:name="com.aimer.AimerActivity"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|screenSize|uiMode"
            android:windowSoftInputMode="stateHidden|adjustResize">
            <meta-data android:name="android.app.lib_name" android:value="jaime" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>